#!/usr/bin/env bash
set -uo pipefail
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SELF_DIR/.." && pwd)"
if ! command -v node >/dev/null 2>&1; then
  echo "Node >=22.19.0 is required. Install Node, then run npm install from $ROOT." >&2
  exit 5
fi
if [ ! -d "$ROOT/node_modules/jiti" ]; then
  echo "Council dependencies are missing. Run: npm install from $ROOT" >&2
  exit 5
fi
exec node --import "$ROOT/node_modules/jiti/lib/jiti-register.mjs" "$ROOT/extensions/council/cli.ts" "$@"

# Planning docs live in /docs and are gitignored.
# Public docs go in /docs/public/ and ARE tracked.
/docs/*
!/docs/public/

# Python bytecode from the provider-layer helpers.
__pycache__/
*.pyc

# Runtime output written by the /ai-synthesis skill (project-local sessions + work).
/.ai-synthesis/

# Claude Code local + runtime artifacts (not shared).
/.claude/settings.local.json
/.claude/*.lock

# Node dependencies for the portable council package baseline.
node_modules/

# Project-local secrets: bin/lib/common.sh reads repo-root .env.local when NVIDIA_API_KEY is unset.
/.env.local
